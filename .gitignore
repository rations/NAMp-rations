# Local-only agent guidance (not published; comments in tracked files must not
# reference these)
CLAUDE.md
RULES.md
task.md
PLAN.md
.claude/

# captures/ is deliberately NOT ignored here, unlike in the parent project. These
# are the author's own captures of the four channels, they are the product rather
# than a working set, and they ship inside the bundle's Contents/Resources — so
# tracked source names them by path and a fresh clone must be able to build a
# working plug-in.

# Personal CMake configure presets (local reference-tree paths).
CMakeUserPresets.json

# Build directories
build/
build-*/
cmake-build-*/

# CMake generated
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake
!CMakeLists.txt
# ...but cmake/ holds SOURCE scripts, not generated ones — the MinGW toolchain
# file lives there and is named on the configure command line, so without this
# negation the blanket *.cmake above would keep it out of a fresh clone and the
# Windows build would be unreproducible. Generated .cmake files all live under
# the build directories already ignored above.
!cmake/*.cmake

# Compiled output
*.o
*.a
*.so
*.so.*
*.vst3
# ...the bundled captures are tracked content, not build output, and none of the
# patterns above match .nam — this is only here so the next person does not add a
# blanket rule that does.
!captures/**/*.nam

# Release archives produced by scripts/makedist-linux.sh — these are attached
# to GitHub releases, not committed.
dist/
*.tar.gz
*.tar.xz
*.zip

# Debug info
*.pdb
*.dSYM/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~
.clangd/
compile_commands.json

# OS
.DS_Store
Thumbs.db
